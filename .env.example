# ==============================================================================
# PESTPILOT ENVIRONMENT VARIABLES (.env.example)
# Field-Service Management for Pest Control Teams
# ==============================================================================

# 1. PostgreSQL Database URL
# Local Docker: postgresql://pestpilot:pestpilot_password@localhost:5432/pestpilot_db?schema=public
# Production: Hosted PostgreSQL on Neon (https://neon.tech) or Supabase (https://supabase.com)
DATABASE_URL="postgresql://pestpilot:pestpilot_password@localhost:5432/pestpilot_db"

# 2. NextAuth v5 Authentication Secret & App URL
# Generate a secret with: openssl rand -base64 33
AUTH_SECRET="LZMl/woPBGf8e/L4E42jmvecMFtXwxTVGhd9CKPDPuE="
AUTH_TRUST_HOST=true
# AUTH_URL is auto-detected dynamically in local development on any port (3000, 3001, 3002, etc.)
# Set AUTH_URL only in production (e.g., AUTH_URL="https://yourdomain.com")

# 3. Google OAuth Credentials (Optional)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3002/api/auth/callback/google
AUTH_GOOGLE_ID="226912664685-nggdbbe5dmk71tqqvjrp2h8kt6qeaq4a.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="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"

# 4. Stripe Subscriptions & Invoicing (Stripe Dashboard -> Developers -> API Keys)
# Secret key starts with sk_test_ or sk_live_
STRIPE_SECRET_KEY="sk_test_..."
# Webhook signing secret from Stripe CLI or Stripe Dashboard Webhooks (whsec_...)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Stripe Recurring Price IDs for Pro ($29/mo) and Business ($59/mo) plans
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_BUSINESS_PRICE_ID="price_..."
# Stripe Publishable key (starts with pk_test_ or pk_live_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# 5. Resend Email Delivery (https://resend.com/api-keys)
# Starts with re_... Leave empty to simulate emails in development logs
RESEND_API_KEY=""
EMAIL_FROM="notifications@pestpilot.app"

# 6. Twilio SMS Notifications (Optional) (https://console.twilio.com)
# Adapter automatically disables itself if these keys are left empty
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# 7. Secured Cron Job Secret
# Used to authenticate automated reminder requests to /api/cron/reminders
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="your-secure-random-cron-secret-pestpilot"

# 8. Canonical Public Web App URL (auto-detected dynamically from current browser/server port in development)
# Set in production to your live domain (e.g. NEXT_PUBLIC_APP_URL="https://yourdomain.com")
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

